# ORE Refined Configuration
# Copy this file to .env and fill in your values

# RPC URL - Your Solana RPC provider (Helius recommended)
RPC_URL=https://your-rpc-url.com

# Path to your Solana keypair file
KEYPAIR_PATH=/path/to/your/keypair.json

# Fraction of the signer SOL balance to deploy, in basis points (100 = 1%, default: 400)
DEPLOY_BPS=400

# Deploy only in the final N slots of each round (default: 15)
REMAINING_SLOTS=15

# Minimum acceptable expected value in basis points (e.g. -500 = accept -5%).
# Blocks below this EV are skipped. (default: -500)
MIN_EV_THRESHOLD_BPS=-500

# Number of smallest blocks to target, 1-12 (default: 5)
NUM_BLOCKS=5
